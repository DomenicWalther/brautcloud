# Local-only Compose/application configuration. Never use in production.
# Replace every CHANGE_ME value before starting Compose.
POSTGRES_DB=brautcloud_local
POSTGRES_USER=CHANGE_ME_local_user
POSTGRES_PW=CHANGE_ME_local_database_password
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/brautcloud_local

AISTOR_ROOT_USER=CHANGE_ME_local_storage_user
AISTOR_ROOT_PASSWORD=CHANGE_ME_local_storage_password
AISTOR_LICENSE_FILE=./.local/minio.license
AWS_ACCESS_KEY_ID=CHANGE_ME_local_storage_user
AWS_SECRET_ACCESS_KEY=CHANGE_ME_local_storage_password
AWS_ENDPOINT=http://127.0.0.1:9000

JWT_SECRET=CHANGE_ME_generate_random_local_secret
APP_ALLOWED_ORIGINS=http://localhost:4200
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Strict
APP_GUEST_COOKIE_SAME_SITE=Lax
SPRING_PROFILES_ACTIVE=local
