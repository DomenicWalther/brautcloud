meta {
  name: Auth::Login
  type: http
  seq: 10
}

post {
  url: http://localhost:8080/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{$processEnv BRAUTCLOUD_LOCAL_TEST_EMAIL}}",
    "password": "{{$processEnv BRAUTCLOUD_LOCAL_TEST_PASSWORD}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
