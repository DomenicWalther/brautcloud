{
  "name": "brautcloud-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build-production.mjs",
    "assert:production-config": "node scripts/assert-production-config.mjs",
    "test:production-config": "node --test scripts/production-config.test.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write 'src/**/*.{ts,html,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,html,css}'",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "lenis": "^1.3.18",
    "ng-qrcode": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@tailwindcss/postcss": "^4.1.12",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "src/**/*.{ts,html,css}": "prettier --write"
  }
}
